{
  "metadata": {
    "name": "Multi-Tier VPC",
    "description": "VPC with public and private subnets for separation of concerns",
    "version": "1.0.0",
    "createdAt": "2025-09-04T12:00:00.000Z",
    "lastModified": "2025-09-04T12:00:00.000Z",
    "provider": "aws"
  },
  "nodes": [
    {
      "id": "vpc_main",
      "nodeType": "awsContainer",
      "serviceType": "vpc",
      "name": "Multi-Tier VPC",
      "icon": "/aws_icons/networking_content_delivery/32/arch_amazon_virtual_private_cloud_32.svg",
      "position": { "x": 50, "y": 50 },
      "dimensions": { "width": 700, "height": 500 },
      "configuration": {
        "cidrBlock": "10.0.0.0/16",
        "enableDnsHostnames": true,
        "enableDnsSupport": true
      },
      "isContainer": true
    },
    {
      "id": "subnet_public_1",
      "nodeType": "awsContainer",
      "serviceType": "public-subnet",
      "name": "Public Subnet 1",
      "icon": "/aws_icons/uncategorized/32/public_subnet_32.svg",
      "position": { "x": 100, "y": 100 },
      "dimensions": { "width": 250, "height": 150 },
      "configuration": {
        "cidrBlock": "10.0.1.0/24",
        "availabilityZone": "us-east-1a",
        "mapPublicIpOnLaunch": true
      },
      "isContainer": true,
      "parentId": "vpc_main"
    },
    {
      "id": "subnet_public_2",
      "nodeType": "awsContainer",
      "serviceType": "public-subnet",
      "name": "Public Subnet 2",
      "icon": "/aws_icons/uncategorized/32/public_subnet_32.svg",
      "position": { "x": 400, "y": 100 },
      "dimensions": { "width": 250, "height": 150 },
      "configuration": {
        "cidrBlock": "10.0.2.0/24",
        "availabilityZone": "us-east-1b",
        "mapPublicIpOnLaunch": true
      },
      "isContainer": true,
      "parentId": "vpc_main"
    },
    {
      "id": "subnet_private_1",
      "nodeType": "awsContainer",
      "serviceType": "private-subnet",
      "name": "Private Subnet 1",
      "icon": "/aws_icons/uncategorized/32/private_subnet_32.svg",
      "position": { "x": 100, "y": 300 },
      "dimensions": { "width": 250, "height": 150 },
      "configuration": {
        "cidrBlock": "10.0.3.0/24",
        "availabilityZone": "us-east-1a",
        "mapPublicIpOnLaunch": false
      },
      "isContainer": true,
      "parentId": "vpc_main"
    },
    {
      "id": "subnet_private_2",
      "nodeType": "awsContainer",
      "serviceType": "private-subnet",
      "name": "Private Subnet 2",
      "icon": "/aws_icons/uncategorized/32/private_subnet_32.svg",
      "position": { "x": 400, "y": 300 },
      "dimensions": { "width": 250, "height": 150 },
      "configuration": {
        "cidrBlock": "10.0.4.0/24",
        "availabilityZone": "us-east-1b",
        "mapPublicIpOnLaunch": false
      },
      "isContainer": true,
      "parentId": "vpc_main"
    },
    {
      "id": "ec2_web_1",
      "nodeType": "awsService",
      "serviceType": "ec2",
      "name": "Web Server 1",
      "icon": "/aws_icons/compute/32/arch_amazon_ec2_32.svg",
      "position": { "x": 175, "y": 150 },
      "configuration": {
        "instanceType": "t3.micro",
        "ami": "ami-0c02fb55956c7d316",
        "keyPair": "my-key-pair",
        "userData": "#!/bin/bash\nyum update -y\nyum install -y httpd\nsystemctl start httpd\nsystemctl enable httpd"
      },
      "parentId": "subnet_public_1"
    },
    {
      "id": "ec2_web_2",
      "nodeType": "awsService",
      "serviceType": "ec2",
      "name": "Web Server 2",
      "icon": "/aws_icons/compute/32/arch_amazon_ec2_32.svg",
      "position": { "x": 475, "y": 150 },
      "configuration": {
        "instanceType": "t3.micro",
        "ami": "ami-0c02fb55956c7d316",
        "keyPair": "my-key-pair",
        "userData": "#!/bin/bash\nyum update -y\nyum install -y httpd\nsystemctl start httpd\nsystemctl enable httpd"
      },
      "parentId": "subnet_public_2"
    },
    {
      "id": "ec2_app_1",
      "nodeType": "awsService",
      "serviceType": "ec2",
      "name": "App Server 1",
      "icon": "/aws_icons/compute/32/arch_amazon_ec2_32.svg",
      "position": { "x": 175, "y": 350 },
      "configuration": {
        "instanceType": "t3.small",
        "ami": "ami-0c02fb55956c7d316",
        "keyPair": "my-key-pair",
        "userData": "#!/bin/bash\nyum update -y"
      },
      "parentId": "subnet_private_1"
    },
    {
      "id": "ec2_app_2",
      "nodeType": "awsService",
      "serviceType": "ec2",
      "name": "App Server 2",
      "icon": "/aws_icons/compute/32/arch_amazon_ec2_32.svg",
      "position": { "x": 475, "y": 350 },
      "configuration": {
        "instanceType": "t3.small",
        "ami": "ami-0c02fb55956c7d316",
        "keyPair": "my-key-pair",
        "userData": "#!/bin/bash\nyum update -y"
      },
      "parentId": "subnet_private_2"
    },
    {
      "id": "sg_web",
      "nodeType": "awsContainer",
      "serviceType": "security-group",
      "name": "Web Security Group",
      "icon": "/aws_icons/uncategorized/32/ec2_instance_contents_32.svg",
      "position": { "x": 750, "y": 150 },
      "dimensions": { "width": 100, "height": 100 },
      "configuration": {
        "description": "Security group for web servers",
        "ingressRules": [
          {
            "port": 80,
            "protocol": "tcp",
            "source": "0.0.0.0/0",
            "description": "HTTP"
          },
          {
            "port": 443,
            "protocol": "tcp",
            "source": "0.0.0.0/0",
            "description": "HTTPS"
          }
        ],
        "egressRules": [
          {
            "port": "all",
            "protocol": "all",
            "destination": "0.0.0.0/0",
            "description": "All outbound traffic"
          }
        ]
      },
      "isContainer": true,
      "parentId": "vpc_main"
    },
    {
      "id": "sg_app",
      "nodeType": "awsContainer",
      "serviceType": "security-group",
      "name": "App Security Group",
      "icon": "/aws_icons/uncategorized/32/ec2_instance_contents_32.svg",
      "position": { "x": 750, "y": 300 },
      "dimensions": { "width": 100, "height": 100 },
      "configuration": {
        "description": "Security group for application servers",
        "ingressRules": [
          {
            "port": 8080,
            "protocol": "tcp",
            "source": "sg_web",
            "description": "Application port from web tier"
          }
        ],
        "egressRules": [
          {
            "port": "all",
            "protocol": "all",
            "destination": "0.0.0.0/0",
            "description": "All outbound traffic"
          }
        ]
      },
      "isContainer": true,
      "parentId": "vpc_main"
    }
  ],
  "connections": [
    {
      "id": "conn_web1_app1",
      "source": "ec2_web_1",
      "target": "ec2_app_1",
      "sourceHandle": "bottom",
      "targetHandle": "top",
      "type": "smoothstep"
    },
    {
      "id": "conn_web2_app2",
      "source": "ec2_web_2",
      "target": "ec2_app_2",
      "sourceHandle": "bottom",
      "targetHandle": "top",
      "type": "smoothstep"
    },
    {
      "id": "conn_sg_web_ec2",
      "source": "sg_web",
      "target": "ec2_web_1",
      "sourceHandle": "left",
      "targetHandle": "right",
      "type": "smoothstep"
    },
    {
      "id": "conn_sg_app_ec2",
      "source": "sg_app",
      "target": "ec2_app_1",
      "sourceHandle": "left",
      "targetHandle": "right",
      "type": "smoothstep"
    }
  ],
  "variables": {
    "environment": {
      "description": "Environment name",
      "type": "string",
      "default": "dev"
    },
    "web_instance_type": {
      "description": "Web tier instance type",
      "type": "string",
      "default": "t3.micro"
    },
    "app_instance_type": {
      "description": "Application tier instance type",
      "type": "string",
      "default": "t3.small"
    }
  },
  "outputs": {
    "vpc_id": {
      "description": "ID of the VPC",
      "value": "vpc_main"
    },
    "public_subnet_1_id": {
      "description": "ID of public subnet 1",
      "value": "subnet_public_1"
    },
    "public_subnet_2_id": {
      "description": "ID of public subnet 2",
      "value": "subnet_public_2"
    },
    "private_subnet_1_id": {
      "description": "ID of private subnet 1",
      "value": "subnet_private_1"
    },
    "private_subnet_2_id": {
      "description": "ID of private subnet 2",
      "value": "subnet_private_2"
    }
  }
}
