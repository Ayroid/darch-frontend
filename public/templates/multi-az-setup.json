{
  "metadata": {
    "name": "Multi-AZ Infrastructure",
    "description": "High availability setup across multiple availability zones with proper regional structure",
    "version": "1.0.0",
    "createdAt": "2025-09-04T12:00:00.000Z",
    "lastModified": "2025-09-04T12:00:00.000Z",
    "provider": "aws"
  },
  "nodes": [
    {
      "id": "region_main",
      "nodeType": "awsContainer",
      "serviceType": "region",
      "name": "AWS Region",
      "icon": "/aws_icons/uncategorized/32/aws_cloud_32.svg",
      "position": { "x": 25, "y": 25 },
      "dimensions": { "width": 950, "height": 650 },
      "configuration": {
        "regionName": "us-east-1",
        "regionDisplayName": "US East (N. Virginia)"
      },
      "isContainer": true
    },
    {
      "id": "az_1",
      "nodeType": "awsContainer",
      "serviceType": "availability-zone",
      "name": "Availability Zone 1a",
      "icon": "/aws_icons/uncategorized/32/region_32.svg",
      "position": { "x": 75, "y": 75 },
      "dimensions": { "width": 400, "height": 550 },
      "configuration": {
        "availabilityZone": "us-east-1a"
      },
      "isContainer": true,
      "parentId": "region_main"
    },
    {
      "id": "az_2",
      "nodeType": "awsContainer",
      "serviceType": "availability-zone",
      "name": "Availability Zone 1b",
      "icon": "/aws_icons/uncategorized/32/region_32.svg",
      "position": { "x": 525, "y": 75 },
      "dimensions": { "width": 400, "height": 550 },
      "configuration": {
        "availabilityZone": "us-east-1b"
      },
      "isContainer": true,
      "parentId": "region_main"
    },
    {
      "id": "vpc_main",
      "nodeType": "awsContainer",
      "serviceType": "vpc",
      "name": "Production VPC",
      "icon": "/aws_icons/networking_content_delivery/32/arch_amazon_virtual_private_cloud_32.svg",
      "position": { "x": 125, "y": 125 },
      "dimensions": { "width": 750, "height": 450 },
      "configuration": {
        "cidrBlock": "10.0.0.0/16",
        "enableDnsHostnames": true,
        "enableDnsSupport": true
      },
      "isContainer": true,
      "parentId": "region_main"
    },
    {
      "id": "subnet_public_1a",
      "nodeType": "awsContainer",
      "serviceType": "public-subnet",
      "name": "Public Subnet 1a",
      "icon": "/aws_icons/uncategorized/32/public_subnet_32.svg",
      "position": { "x": 175, "y": 175 },
      "dimensions": { "width": 250, "height": 150 },
      "configuration": {
        "cidrBlock": "10.0.1.0/24",
        "availabilityZone": "us-east-1a",
        "mapPublicIpOnLaunch": true
      },
      "isContainer": true,
      "parentId": "vpc_main"
    },
    {
      "id": "subnet_public_1b",
      "nodeType": "awsContainer",
      "serviceType": "public-subnet",
      "name": "Public Subnet 1b",
      "icon": "/aws_icons/uncategorized/32/public_subnet_32.svg",
      "position": { "x": 575, "y": 175 },
      "dimensions": { "width": 250, "height": 150 },
      "configuration": {
        "cidrBlock": "10.0.2.0/24",
        "availabilityZone": "us-east-1b",
        "mapPublicIpOnLaunch": true
      },
      "isContainer": true,
      "parentId": "vpc_main"
    },
    {
      "id": "subnet_private_1a",
      "nodeType": "awsContainer",
      "serviceType": "private-subnet",
      "name": "Private Subnet 1a",
      "icon": "/aws_icons/uncategorized/32/private_subnet_32.svg",
      "position": { "x": 175, "y": 375 },
      "dimensions": { "width": 250, "height": 150 },
      "configuration": {
        "cidrBlock": "10.0.3.0/24",
        "availabilityZone": "us-east-1a",
        "mapPublicIpOnLaunch": false
      },
      "isContainer": true,
      "parentId": "vpc_main"
    },
    {
      "id": "subnet_private_1b",
      "nodeType": "awsContainer",
      "serviceType": "private-subnet",
      "name": "Private Subnet 1b",
      "icon": "/aws_icons/uncategorized/32/private_subnet_32.svg",
      "position": { "x": 575, "y": 375 },
      "dimensions": { "width": 250, "height": 150 },
      "configuration": {
        "cidrBlock": "10.0.4.0/24",
        "availabilityZone": "us-east-1b",
        "mapPublicIpOnLaunch": false
      },
      "isContainer": true,
      "parentId": "vpc_main"
    },
    {
      "id": "ec2_web_1a",
      "nodeType": "awsService",
      "serviceType": "ec2",
      "name": "Web Server 1a",
      "icon": "/aws_icons/compute/32/arch_amazon_ec2_32.svg",
      "position": { "x": 250, "y": 225 },
      "configuration": {
        "instanceType": "t3.small",
        "ami": "ami-0c02fb55956c7d316",
        "keyPair": "production-key-pair",
        "userData": "#!/bin/bash\nyum update -y\nyum install -y httpd\nsystemctl start httpd\nsystemctl enable httpd\necho '<h1>Web Server in AZ 1a</h1>' > /var/www/html/index.html"
      },
      "parentId": "subnet_public_1a"
    },
    {
      "id": "ec2_web_1b",
      "nodeType": "awsService",
      "serviceType": "ec2",
      "name": "Web Server 1b",
      "icon": "/aws_icons/compute/32/arch_amazon_ec2_32.svg",
      "position": { "x": 650, "y": 225 },
      "configuration": {
        "instanceType": "t3.small",
        "ami": "ami-0c02fb55956c7d316",
        "keyPair": "production-key-pair",
        "userData": "#!/bin/bash\nyum update -y\nyum install -y httpd\nsystemctl start httpd\nsystemctl enable httpd\necho '<h1>Web Server in AZ 1b</h1>' > /var/www/html/index.html"
      },
      "parentId": "subnet_public_1b"
    },
    {
      "id": "ec2_app_1a",
      "nodeType": "awsService",
      "serviceType": "ec2",
      "name": "App Server 1a",
      "icon": "/aws_icons/compute/32/arch_amazon_ec2_32.svg",
      "position": { "x": 250, "y": 425 },
      "configuration": {
        "instanceType": "t3.medium",
        "ami": "ami-0c02fb55956c7d316",
        "keyPair": "production-key-pair",
        "userData": "#!/bin/bash\nyum update -y\nyum install -y nodejs npm\necho 'Application server in AZ 1a'"
      },
      "parentId": "subnet_private_1a"
    },
    {
      "id": "ec2_app_1b",
      "nodeType": "awsService",
      "serviceType": "ec2",
      "name": "App Server 1b",
      "icon": "/aws_icons/compute/32/arch_amazon_ec2_32.svg",
      "position": { "x": 650, "y": 425 },
      "configuration": {
        "instanceType": "t3.medium",
        "ami": "ami-0c02fb55956c7d316",
        "keyPair": "production-key-pair",
        "userData": "#!/bin/bash\nyum update -y\nyum install -y nodejs npm\necho 'Application server in AZ 1b'"
      },
      "parentId": "subnet_private_1b"
    },
    {
      "id": "sg_web",
      "nodeType": "awsContainer",
      "serviceType": "security-group",
      "name": "Web Tier Security Group",
      "icon": "/aws_icons/uncategorized/32/ec2_instance_contents_32.svg",
      "position": { "x": 450, "y": 250 },
      "dimensions": { "width": 100, "height": 80 },
      "configuration": {
        "description": "Security group for web servers",
        "ingressRules": [
          {
            "port": 80,
            "protocol": "tcp",
            "source": "0.0.0.0/0",
            "description": "HTTP"
          },
          {
            "port": 443,
            "protocol": "tcp",
            "source": "0.0.0.0/0",
            "description": "HTTPS"
          }
        ],
        "egressRules": [
          {
            "port": "all",
            "protocol": "all",
            "destination": "0.0.0.0/0",
            "description": "All outbound traffic"
          }
        ]
      },
      "isContainer": true,
      "parentId": "vpc_main"
    },
    {
      "id": "sg_app",
      "nodeType": "awsContainer",
      "serviceType": "security-group",
      "name": "App Tier Security Group",
      "icon": "/aws_icons/uncategorized/32/ec2_instance_contents_32.svg",
      "position": { "x": 450, "y": 450 },
      "dimensions": { "width": 100, "height": 80 },
      "configuration": {
        "description": "Security group for application servers",
        "ingressRules": [
          {
            "port": 8080,
            "protocol": "tcp",
            "source": "sg_web",
            "description": "Application port from web tier"
          },
          {
            "port": 3000,
            "protocol": "tcp",
            "source": "sg_web",
            "description": "Node.js application port"
          }
        ],
        "egressRules": [
          {
            "port": "all",
            "protocol": "all",
            "destination": "0.0.0.0/0",
            "description": "All outbound traffic"
          }
        ]
      },
      "isContainer": true,
      "parentId": "vpc_main"
    }
  ],
  "connections": [
    {
      "id": "conn_web1a_app1a",
      "source": "ec2_web_1a",
      "target": "ec2_app_1a",
      "sourceHandle": "bottom",
      "targetHandle": "top",
      "type": "smoothstep"
    },
    {
      "id": "conn_web1b_app1b",
      "source": "ec2_web_1b",
      "target": "ec2_app_1b",
      "sourceHandle": "bottom",
      "targetHandle": "top",
      "type": "smoothstep"
    },
    {
      "id": "conn_web1a_web1b",
      "source": "ec2_web_1a",
      "target": "ec2_web_1b",
      "sourceHandle": "right",
      "targetHandle": "left",
      "type": "smoothstep"
    },
    {
      "id": "conn_app1a_app1b",
      "source": "ec2_app_1a",
      "target": "ec2_app_1b",
      "sourceHandle": "right",
      "targetHandle": "left",
      "type": "smoothstep"
    }
  ],
  "variables": {
    "environment": {
      "description": "Environment name",
      "type": "string",
      "default": "prod"
    },
    "region": {
      "description": "AWS region",
      "type": "string",
      "default": "us-east-1"
    },
    "web_instance_type": {
      "description": "Web tier instance type",
      "type": "string",
      "default": "t3.small"
    },
    "app_instance_type": {
      "description": "Application tier instance type",
      "type": "string",
      "default": "t3.medium"
    }
  },
  "outputs": {
    "region_id": {
      "description": "AWS region",
      "value": "us-east-1"
    },
    "vpc_id": {
      "description": "ID of the VPC",
      "value": "vpc_main"
    },
    "availability_zone_1a": {
      "description": "Availability Zone 1a",
      "value": "us-east-1a"
    },
    "availability_zone_1b": {
      "description": "Availability Zone 1b",
      "value": "us-east-1b"
    },
    "web_server_1a_ip": {
      "description": "Public IP of web server in AZ 1a",
      "value": "${ec2_web_1a.public_ip}"
    },
    "web_server_1b_ip": {
      "description": "Public IP of web server in AZ 1b",
      "value": "${ec2_web_1b.public_ip}"
    }
  }
}
