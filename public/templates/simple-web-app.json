{
  "metadata": {
    "name": "Basic Web Setup",
    "description": "Simple VPC with EC2 instance and security groups for basic web hosting",
    "version": "1.0.0",
    "createdAt": "2025-09-04T12:00:00.000Z",
    "lastModified": "2025-09-04T12:00:00.000Z",
    "provider": "aws"
  },
  "nodes": [
    {
      "id": "vpc_main",
      "nodeType": "awsContainer",
      "serviceType": "vpc",
      "name": "Main VPC",
      "icon": "/aws_icons/networking_content_delivery/32/arch_amazon_virtual_private_cloud_32.svg",
      "position": { "x": 100, "y": 100 },
      "dimensions": { "width": 500, "height": 350 },
      "configuration": {
        "cidrBlock": "10.0.0.0/16",
        "enableDnsHostnames": true,
        "enableDnsSupport": true
      },
      "isContainer": true
    },
    {
      "id": "subnet_public",
      "nodeType": "awsContainer",
      "serviceType": "public-subnet",
      "name": "Public Subnet",
      "icon": "/aws_icons/uncategorized/32/public_subnet_32.svg",
      "position": { "x": 150, "y": 150 },
      "dimensions": { "width": 250, "height": 200 },
      "configuration": {
        "cidrBlock": "10.0.1.0/24",
        "availabilityZone": "us-east-1a",
        "mapPublicIpOnLaunch": true
      },
      "isContainer": true,
      "parentId": "vpc_main"
    },
    {
      "id": "ec2_web",
      "nodeType": "awsService",
      "serviceType": "ec2",
      "name": "Web Server",
      "icon": "/aws_icons/compute/32/arch_amazon_ec2_32.svg",
      "position": { "x": 200, "y": 200 },
      "configuration": {
        "instanceType": "t3.micro",
        "ami": "ami-0c02fb55956c7d316",
        "keyPair": "my-key-pair",
        "userData": "#!/bin/bash\nyum update -y\nyum install -y httpd\nsystemctl start httpd\nsystemctl enable httpd\necho '<h1>Welcome to Simple Web App</h1>' > /var/www/html/index.html"
      },
      "parentId": "subnet_public"
    },
    {
      "id": "sg_web",
      "nodeType": "awsContainer",
      "serviceType": "security-group",
      "name": "Web Security Group",
      "icon": "/aws_icons/uncategorized/32/ec2_instance_contents_32.svg",
      "position": { "x": 450, "y": 200 },
      "dimensions": { "width": 100, "height": 100 },
      "configuration": {
        "description": "Security group for web server",
        "ingressRules": [
          {
            "port": 80,
            "protocol": "tcp",
            "source": "0.0.0.0/0",
            "description": "HTTP"
          },
          {
            "port": 443,
            "protocol": "tcp",
            "source": "0.0.0.0/0",
            "description": "HTTPS"
          },
          {
            "port": 22,
            "protocol": "tcp",
            "source": "10.0.0.0/8",
            "description": "SSH"
          }
        ],
        "egressRules": [
          {
            "port": "all",
            "protocol": "all",
            "destination": "0.0.0.0/0",
            "description": "All outbound traffic"
          }
        ]
      },
      "isContainer": true,
      "parentId": "vpc_main"
    }
  ],
  "connections": [
    {
      "id": "conn_sg_ec2",
      "source": "sg_web",
      "target": "ec2_web",
      "sourceHandle": "left",
      "targetHandle": "right",
      "type": "smoothstep"
    }
  ],
  "variables": {
    "environment": {
      "description": "Environment name",
      "type": "string",
      "default": "dev"
    },
    "instance_type": {
      "description": "EC2 instance type",
      "type": "string",
      "default": "t3.micro"
    }
  },
  "outputs": {
    "vpc_id": {
      "description": "ID of the VPC",
      "value": "vpc_main"
    },
    "web_server_ip": {
      "description": "Public IP of web server",
      "value": "${ec2_web.public_ip}"
    },
    "security_group_id": {
      "description": "ID of the web security group",
      "value": "sg_web"
    }
  }
}
