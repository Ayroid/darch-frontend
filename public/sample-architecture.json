{
  "metadata": {
    "name": "VPC 2-Tier Web Application",
    "description": "A basic 2-tier web application architecture with VPC, security groups, and EC2 instances",
    "version": "1.0.0",
    "createdAt": "2025-08-23T12:00:00.000Z",
    "lastModified": "2025-08-23T12:00:00.000Z",
    "provider": "aws"
  },
  "nodes": [
    {
      "id": "vpc_1",
      "type": "awsContainer",
      "serviceType": "vpc",
      "name": "Main VPC",
      "icon": "/aws_icons/architecture_group_icons/Virtual-private-cloud-VPC_32.svg",
      "position": { "x": 100, "y": 100 },
      "dimensions": { "width": 600, "height": 400 },
      "configuration": {
        "cidrBlock": "10.0.0.0/16",
        "enableDnsHostnames": true,
        "enableDnsSupport": true
      },
      "isContainer": true
    },
    {
      "id": "subnet_1",
      "type": "awsContainer",
      "serviceType": "subnet",
      "name": "Public Subnet 1",
      "icon": "/aws_icons/architecture_group_icons/Public-subnet_32.svg",
      "position": { "x": 150, "y": 150 },
      "dimensions": { "width": 200, "height": 150 },
      "configuration": {
        "cidrBlock": "10.0.1.0/24",
        "availabilityZone": "us-east-1a",
        "mapPublicIpOnLaunch": true
      },
      "isContainer": true,
      "parentId": "vpc_1"
    },
    {
      "id": "subnet_2",
      "type": "awsContainer",
      "serviceType": "subnet",
      "name": "Public Subnet 2",
      "icon": "/aws_icons/architecture_group_icons/Public-subnet_32.svg",
      "position": { "x": 400, "y": 150 },
      "dimensions": { "width": 200, "height": 150 },
      "configuration": {
        "cidrBlock": "10.0.2.0/24",
        "availabilityZone": "us-east-1b",
        "mapPublicIpOnLaunch": true
      },
      "isContainer": true,
      "parentId": "vpc_1"
    },
    {
      "id": "ec2_1",
      "type": "awsService",
      "serviceType": "ec2",
      "name": "Web Server 1",
      "icon": "/aws_icons/architecture_service_icons/Arch_Compute/Amazon-EC2_48.svg",
      "position": { "x": 200, "y": 200 },
      "configuration": {
        "instanceType": "t3.micro",
        "ami": "ami-0c02fb55956c7d316",
        "keyPair": "my-key-pair",
        "userData": "#!/bin/bash\nyum update -y\nyum install -y httpd\nsystemctl start httpd\nsystemctl enable httpd\necho '<h1>Web Server 1</h1>' > /var/www/html/index.html"
      },
      "parentId": "subnet_1"
    },
    {
      "id": "ec2_2",
      "type": "awsService",
      "serviceType": "ec2",
      "name": "Web Server 2",
      "icon": "/aws_icons/architecture_service_icons/Arch_Compute/Amazon-EC2_48.svg",
      "position": { "x": 450, "y": 200 },
      "configuration": {
        "instanceType": "t3.micro",
        "ami": "ami-0c02fb55956c7d316",
        "keyPair": "my-key-pair",
        "userData": "#!/bin/bash\nyum update -y\nyum install -y httpd\nsystemctl start httpd\nsystemctl enable httpd\necho '<h1>Web Server 2</h1>' > /var/www/html/index.html"
      },
      "parentId": "subnet_2"
    },
    {
      "id": "sg_1",
      "type": "awsService",
      "serviceType": "security-group",
      "name": "Web Security Group",
      "icon": "/aws_icons/architecture_service_icons/Arch_Security-Identity-Compliance/AWS-Identity-and-Access-Management_48.svg",
      "position": { "x": 325, "y": 350 },
      "configuration": {
        "description": "Security group for web servers",
        "ingressRules": [
          {
            "port": 80,
            "protocol": "tcp",
            "source": "0.0.0.0/0",
            "description": "HTTP"
          },
          {
            "port": 443,
            "protocol": "tcp",
            "source": "0.0.0.0/0",
            "description": "HTTPS"
          },
          {
            "port": 22,
            "protocol": "tcp",
            "source": "10.0.0.0/8",
            "description": "SSH"
          }
        ],
        "egressRules": [
          {
            "port": "all",
            "protocol": "all",
            "destination": "0.0.0.0/0",
            "description": "All outbound traffic"
          }
        ]
      },
      "parentId": "vpc_1"
    }
  ],
  "connections": [
    {
      "id": "conn_1",
      "source": "sg_1",
      "target": "ec2_1",
      "sourceHandle": "top",
      "targetHandle": "bottom",
      "type": "smoothstep"
    },
    {
      "id": "conn_2",
      "source": "sg_1",
      "target": "ec2_2",
      "sourceHandle": "top",
      "targetHandle": "bottom",
      "type": "smoothstep"
    }
  ],
  "variables": {
    "environment": {
      "description": "Environment name",
      "type": "string",
      "default": "dev"
    },
    "instance_type": {
      "description": "EC2 instance type",
      "type": "string",
      "default": "t3.micro"
    }
  },
  "outputs": {
    "vpc_id": {
      "description": "ID of the VPC",
      "value": "vpc_1"
    },
    "web_server_1_ip": {
      "description": "Public IP of web server 1",
      "value": "${ec2_1.public_ip}"
    },
    "web_server_2_ip": {
      "description": "Public IP of web server 2",
      "value": "${ec2_2.public_ip}"
    },
    "security_group_id": {
      "description": "ID of the web security group",
      "value": "sg_1"
    }
  }
}
